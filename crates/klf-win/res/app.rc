#include <winver.h>
1 24 "app.manifest"
1 ICON "klf.ico"
2 ICON "klf-pause.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,8,6,0
PRODUCTVERSION 1,8,6,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "breslev558"
      VALUE "FileDescription", "Keyboard Layout Fixer - fixes Hebrew/English text typed with the wrong layout (F10)"
      VALUE "FileVersion", "1.8.6.0"
      VALUE "InternalName", "KeyboardLayoutFixer"
      VALUE "LegalCopyright", "MIT License - Copyright (c) Ravid Saadia, NOAM version breslev558"
      VALUE "OriginalFilename", "KeyboardLayoutFixer.exe"
      VALUE "ProductName", "Keyboard Layout Fixer (NOAM)"
      VALUE "ProductVersion", "1.8.6-noam"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
